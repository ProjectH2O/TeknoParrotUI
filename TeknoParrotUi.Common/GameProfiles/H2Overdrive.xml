<?xml version="1.0" encoding="utf-8"?>
<GameProfile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <GameName>H2Overdrive</GameName>
  <GameGenre>Racing</GameGenre>
  <GamePath/>
  <TestMenuParameter></TestMenuParameter>
  <TestMenuIsExecutable>false</TestMenuIsExecutable>
  <ExtraParameters/>
  <TestMenuExtraParameters/>
  <IconName>Icons\H2Overdrive.png</IconName>
  <EmulationProfile>RawThrillsFNFH2O</EmulationProfile>
  <GameProfileRevision>24</GameProfileRevision>
  <HasSeparateTestMode>false</HasSeparateTestMode>
  <EmulatorType>OpenParrot</EmulatorType>
  <ExecutableName>sdaemon.exe</ExecutableName>
  <ConfigValues>
    <FieldInformation>
      <CategoryName>General</CategoryName>
      <FieldName>DisplayMode</FieldName>
      <FieldValue>Borderless</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>Borderless</string>
        <string>Windowed</string>
        <string>Fullscreen</string>
      </FieldOptions>
      <Hint>Borderless: full screen without exclusive mode. Windowed: a window sized to the resolution. Fullscreen: exclusive fullscreen.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>General</CategoryName>
      <FieldName>ResolutionWidth</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Text</FieldType>
      <Hint>Render width. 0 = desktop resolution. 1360 x 768 = original arcade resolution. No need for the resolution patcher.</Hint>
      <FieldOptions />
    </FieldInformation>
    <FieldInformation>
      <CategoryName>General</CategoryName>
      <FieldName>ResolutionHeight</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Text</FieldType>
      <Hint>Render height. 0 = desktop resolution.</Hint>
      <FieldOptions />
    </FieldInformation>
    <FieldInformation>
      <CategoryName>General</CategoryName>
      <FieldName>FpsLimitEnable</FieldName>
      <FieldValue>1</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Limit the frame rate to 60 FPS, the speed the game was designed for (replaces RTSS)</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>General</CategoryName>
      <FieldName>DisableVSync</FieldName>
      <FieldValue>1</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Turn off the game's vsync (recommended with the FPS limit, and for windowed/borderless or non-60 Hz monitors). Untick only for fullscreen on a 60 Hz monitor.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>General</CategoryName>
      <FieldName>Force End Race Key</FieldName>
      <FieldValue>0x7B</FieldValue>
      <FieldType>Text</FieldType>
      <Hint>Key that ends the current race by running the timer down to zero (virtual-key code, like the Exit/Pause keys: 0x7B = F12, 0x7A = F11). Leave empty to turn it off.</Hint>
      <FieldOptions />
    </FieldInformation>
    <FieldInformation>
      <CategoryName>General</CategoryName>
      <FieldName>Debug Log</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Write OpenParrotH2O.log next to the game exe (display, resolution patch, hooks, network, FPS every 5 s). Turn on only when troubleshooting.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>General</CategoryName>
      <FieldName>Input API</FieldName>
      <FieldValue>DirectInput</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>DirectInput</string>
